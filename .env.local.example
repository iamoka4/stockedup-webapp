# Copy to .env.local and fill in real values before running `npm run dev`.

# The existing StockedUp PHP backend — same one the Android app talks to.
NEXT_PUBLIC_API_BASE_URL=https://api.stockedup.africa/backend/api

# This web app's own public URL, used for canonical/OG metadata.
NEXT_PUBLIC_SITE_URL=https://stockedup.africa

# Paystack PUBLIC key (safe to expose client-side — never the secret key).
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

NEXT_PUBLIC_PLAY_STORE_URL=https://play.google.com/store/apps/details?id=com.africa.stockedup&pcampaignid=web_share
NEXT_PUBLIC_APP_STORE_URL=